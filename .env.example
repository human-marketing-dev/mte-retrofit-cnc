# Brevo transactional email — used by app/api/lead/route.ts to notify sales of
# a new lead. Server-only; never prefixed NEXT_PUBLIC_, so it is not exposed to
# the browser. Copy this file to .env.local and fill in the real key.
#
#   cp .env.example .env.local
#
# Get the key from Brevo → SMTP & API → API Keys.
BREVO_API_KEY=

# Google Tag Manager container. Public by nature — the id ships in the page, so
# NEXT_PUBLIC_ is correct here. Defaults to the production container when unset
# (see lib/analytics/GoogleTagManager.tsx); set it to an empty string on a
# preview deployment that should not report into production analytics.
NEXT_PUBLIC_GTM_ID=GTM-5G5699ZJ
